@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesTracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center">
    <div class="text-center">
        <div class="text-9xl mb-4">🚫</div>
        <h1 class="text-4xl font-black text-red-600 mb-4">Access Denied</h1>
        <p class="text-slate-600 mb-8">You don't have permission to access this resource.</p>
        <a href="/" class="bg-blue-900 text-white px-8 py-3 rounded-xl font-black uppercase inline-block hover:bg-blue-800 transition">Go Home</a>
    </div>
</body>
</html>

@model List<SalesTracker.Web.ViewModels.Login.UserManagementViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-6 fw-black text-primary mb-0">USER MANAGEMENT</h2>
        <a asp-action="Register" class="btn btn-primary btn-lg fw-black text-uppercase">
            ➕ Add New User
        </a>
    </div>

    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="fw-black text-uppercase small">Name</th>
                        <th class="fw-black text-uppercase small">Email</th>
                        <th class="fw-black text-uppercase small">Roles</th>
                        <th class="text-center fw-black text-uppercase small">Status</th>
                        <th class="text-center fw-black text-uppercase small">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleUserStatus" asp-controller="Account" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success") fw-bold">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

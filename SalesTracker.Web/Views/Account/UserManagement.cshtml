@model List<SalesTracker.Web.ViewModels.Login.UserManagementViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container mx-auto px-4 py-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-black text-blue-900 uppercase">User Management</h2>
        <a asp-action="Register" class="bg-blue-900 text-white px-6 py-3 rounded-xl font-black uppercase text-sm">
            ➕ Add New User
        </a>
    </div>

    <div class="glass-card p-0 overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-blue-900 text-white uppercase text-xs">
                <tr>
                    <th class="p-4">Name</th>
                    <th class="p-4">Email</th>
                    <th class="p-4">Roles</th>
                    <th class="p-4 text-center">Status</th>
                    <th class="p-4 text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y bg-white">
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="p-4 font-bold text-blue-900">@user.FirstName @user.LastName</td>
                        <td class="p-4">@user.Email</td>
                        <td class="p-4">
                            @foreach (var role in user.Roles)
                            {
                                <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-bold mr-2">@role</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            @if (user.IsActive)
                            {
                                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-bold">Active</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-xs font-bold">Inactive</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            <form asp-action="ToggleUserStatus" asp-controller="Account" method="post" class="inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="text-blue-600 hover:text-blue-800 font-bold">
                                    @(user.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

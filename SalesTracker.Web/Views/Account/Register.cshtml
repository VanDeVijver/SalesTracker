@model SalesTracker.Web.ViewModels.Login.RegisterViewModel
@{
    ViewData["Title"] = "Register New User";
}

<div class="container mx-auto px-4 py-6 max-w-2xl">
    <div class="glass-card border-t-8 border-blue-900">
        <h2 class="text-2xl font-black text-blue-900 mb-6 uppercase">Register New User</h2>

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-6">
                <p class="text-green-700 font-bold">@TempData["Success"]</p>
            </div>
        }

        <form asp-action="Register" asp-controller="Account" method="post" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-bold text-slate-700 mb-2">First Name</label>
                    <input asp-for="FirstName" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none" />
                    <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-sm font-bold text-slate-700 mb-2">Last Name</label>
                    <input asp-for="LastName" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none" />
                    <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-bold text-slate-700 mb-2">Email</label>
                <input asp-for="Email" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none" />
                <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
            </div>

            <div>
                <label asp-for="Role" class="block text-sm font-bold text-slate-700 mb-2">Role</label>
                <select asp-for="Role" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none">
                    <option value="User">User</option>
                    <option value="Manager">Manager</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="text-red-500 text-xs"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Password" class="block text-sm font-bold text-slate-700 mb-2">Password</label>
                    <input asp-for="Password" type="password" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-bold text-slate-700 mb-2">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div class="flex gap-4 pt-4">
                <button type="submit" class="bg-blue-900 text-white px-8 py-3 rounded-xl font-black uppercase">Create User</button>
                <a asp-action="UserManagement" class="bg-slate-200 text-slate-700 px-8 py-3 rounded-xl font-black uppercase">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model SalesTracker.Web.ViewModels.Login.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesTracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen flex items-center justify-center">
    <div class="bg-white rounded-3xl shadow-2xl p-8 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="bg-yellow-400 text-blue-900 p-4 rounded-full inline-block mb-4">
                <span class="text-3xl font-black">VE</span>
            </div>
            <h1 class="text-3xl font-black text-blue-900 uppercase">VENERGY CRM</h1>
            <p class="text-slate-500 text-sm mt-2">Sign in to your account</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-700 font-bold">
                            @Html.ValidationSummary(false, "", new { @class = "text-red-700" })
                        </p>
                    </div>
                </div>
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post" class="space-y-6">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div>
                <label asp-for="Email" class="block text-sm font-bold text-slate-700 mb-2 uppercase">Email</label>
                <input asp-for="Email" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="admin@salestracker.com" />
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-bold text-slate-700 mb-2 uppercase">Password</label>
                <input asp-for="Password" type="password" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="flex items-center">
                <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                <label asp-for="RememberMe" class="ml-2 block text-sm text-slate-700">Remember me</label>
            </div>

            <button type="submit" class="w-full bg-blue-900 text-white py-4 rounded-xl font-black uppercase text-sm hover:bg-blue-800 transition shadow-lg">
                Sign In
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-slate-500">
            <p>Default credentials: <strong>admin@salestracker.com</strong> / <strong>Admin@123</strong></p>
        </div>
    </div>

    <!-- Validation Scripts - Inline since no layout -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

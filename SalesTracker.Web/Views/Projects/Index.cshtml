@model SalesTracker.Web.ViewModels.ProjectFilterViewModel
@{
    ViewData["Title"] = "Projects";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-black text-primary">
                PROJECTS
                <span class="text-muted fs-4">(@Model.TotalItems total)</span>
            </h1>
            <p class="text-muted">Manage all your sales projects</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg fw-black text-uppercase">
            + New Project
        </a>
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label fw-bold text-uppercase small">Year</label>
                    <select name="year" class="form-select" onchange="this.form.submit()">
                        @{
                            var startYear = 2020;
                            var endYear = DateTime.Now.Year;
                            for (int y = endYear; y >= startYear; y--)
                            {
                                <option value="@y" selected="@(y == Model.Year)">@y</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-uppercase small">Category</label>
                    <select name="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">All Categories</option>
                        @foreach (var item in Model.Categories!)
                        {
                            <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-uppercase small">Lead Channel</label>
                    <select name="leadChannelId" class="form-select" onchange="this.form.submit()">
                        <option value="">All Channels</option>
                        @foreach (var item in Model.LeadChannels!)
                        {
                            <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-uppercase small">Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var item in Model.Statuses!)
                        {
                            <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-uppercase small">Search Customer</label>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search..." class="form-control">
                </div>

                <div class="col-md-1 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary fw-bold">🔍</button>
                    <a asp-action="Index" asp-route-year="@Model.Year" class="btn btn-secondary fw-bold">✕</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Actions Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div class="btn-group" role="group">
                <button onclick="showView('table')" id="btn-table" class="btn btn-primary fw-bold">📋 Table</button>
                <button onclick="showView('kanban')" id="btn-kanban" class="btn btn-outline-primary fw-bold">📊 Kanban</button>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="ExportCsv" asp-route-year="@Model.Year" class="btn btn-success fw-bold">📥 Export CSV</a>
                <button onclick="document.getElementById('importFile').click()" class="btn btn-info fw-bold">📤 Import CSV</button>
                <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" id="importForm" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="file" id="importFile" name="file" accept=".csv" onchange="this.form.submit()" />
                </form>
            </div>
        </div>
    </div>

    <!-- Table View -->
    <div id="tableView">
        @if (Model.Projects.Any())
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-black text-uppercase small">Date</th>
                                <th class="fw-black text-uppercase small">Customer</th>
                                <th class="fw-black text-uppercase small">Type</th>
                                <th class="fw-black text-uppercase small">Category</th>
                                <th class="fw-black text-uppercase small">Lead Channel</th>
                                <th class="fw-black text-uppercase small">Status</th>
                                <th class="text-end fw-black text-uppercase small">Amount</th>
                                <th class="text-end fw-black text-uppercase small">Margin %</th>
                                <th class="text-center fw-black text-uppercase small">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model.Projects)
                            {
                                var statusBadgeClass = project.Status switch
                                {
                                    SalesTracker.Core.Models.ProjectStatus.Pending => "bg-warning text-dark",
                                    SalesTracker.Core.Models.ProjectStatus.Won => "bg-success text-white",
                                    SalesTracker.Core.Models.ProjectStatus.Lost => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };
                                <tr>
                                    <td class="small">@project.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold">@project.Customer</td>
                                    <td><span class="badge bg-light text-dark">@project.ClientType</span></td>
                                    <td class="small">@project.CategoryName</td>
                                    <td class="small channel-style">@project.LeadChannelName</td>
                                    <td><span class="badge @statusBadgeClass">@project.Status</span></td>
                                    <td class="text-end fw-bold amount-style">€@project.Amount.ToString("N0")</td>
                                    <td class="text-end fw-bold margin-style">@project.ManualMarginPercentage.ToString("N2")%</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-info" title="View Details">
                                                👁️
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-primary" title="Edit">
                                                ✏️
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@project.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this project?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                Showing <strong>@Model.Projects.Count</strong> of <strong>@Model.TotalItems</strong> projects
                            </span>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    @if (Model.Page > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index"
                                               asp-route-year="@Model.Year"
                                               asp-route-categoryId="@Model.CategoryId"
                                               asp-route-leadChannelId="@Model.LeadChannelId"
                                               asp-route-status="@Model.Status"
                                               asp-route-searchTerm="@Model.SearchTerm"
                                               asp-route-page="@(Model.Page - 1)">← Prev</a>
                                        </li>
                                    }

                                    @{
                                        var startPage = Math.Max(1, Model.Page - 2);
                                        var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                                    }

                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == Model.Page ? "active" : "")">
                                            <a class="page-link" asp-action="Index"
                                               asp-route-year="@Model.Year"
                                               asp-route-categoryId="@Model.CategoryId"
                                               asp-route-leadChannelId="@Model.LeadChannelId"
                                               asp-route-status="@Model.Status"
                                               asp-route-searchTerm="@Model.SearchTerm"
                                               asp-route-page="@i">@i</a>
                                        </li>
                                    }

                                    @if (Model.Page < Model.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index"
                                               asp-route-year="@Model.Year"
                                               asp-route-categoryId="@Model.CategoryId"
                                               asp-route-leadChannelId="@Model.LeadChannelId"
                                               asp-route-status="@Model.Status"
                                               asp-route-searchTerm="@Model.SearchTerm"
                                               asp-route-page="@(Model.Page + 1)">Next →</a>
                                        </li>
                                    }
                                </ul>
                            </nav>

                            <span class="text-muted small">
                                Page <strong>@Model.Page</strong> of <strong>@Model.TotalPages</strong>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="display-1 text-muted mb-3">📋</div>
                    <h3 class="fw-bold">No projects found</h3>
                    <p class="text-muted">Try adjusting your filters or create a new project</p>
                </div>
            </div>
        }
    </div>

    <!-- Kanban View -->
    <div id="kanbanView" class="d-none">
        <div class="row g-4">
            <!-- Pending Column -->
            <div class="col-lg-4">
                <div class="card bg-warning bg-opacity-10 border-warning">
                    <div class="card-header bg-warning text-dark fw-black">
                        PENDING (@Model.Projects.Count(p => p.Status == SalesTracker.Core.Models.ProjectStatus.Pending))
                    </div>
                    <div class="card-body">
                        @foreach (var project in Model.Projects.Where(p => p.Status == SalesTracker.Core.Models.ProjectStatus.Pending))
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-body">
                                    <h6 class="card-title fw-bold">@project.Customer</h6>
                                    <p class="card-text small text-muted mb-2">@project.CategoryName</p>
                                    <p class="card-text fw-black text-primary">€@project.Amount.ToString("N0")</p>
                                    <p class="card-text small text-muted">@project.Date.ToString("dd/MM/yyyy")</p>
                                    <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-primary">Edit</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Won Column -->
            <div class="col-lg-4">
                <div class="card bg-success bg-opacity-10 border-success">
                    <div class="card-header bg-success text-white fw-black">
                        WON (@Model.Projects.Count(p => p.Status == SalesTracker.Core.Models.ProjectStatus.Won))
                    </div>
                    <div class="card-body">
                        @foreach (var project in Model.Projects.Where(p => p.Status == SalesTracker.Core.Models.ProjectStatus.Won))
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-body">
                                    <h6 class="card-title fw-bold">@project.Customer</h6>
                                    <p class="card-text small text-muted mb-2">@project.CategoryName</p>
                                    <p class="card-text fw-black text-success">€@((project.FinalInvoiceAmount ?? project.Amount).ToString("N0"))</p>
                                    <p class="card-text small text-muted">@project.Date.ToString("dd/MM/yyyy")</p>
                                    <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-primary">Edit</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Lost Column -->
            <div class="col-lg-4">
                <div class="card bg-danger bg-opacity-10 border-danger">
                    <div class="card-header bg-danger text-white fw-black">
                        LOST (@Model.Projects.Count(p => p.Status == SalesTracker.Core.Models.ProjectStatus.Lost))
                    </div>
                    <div class="card-body">
                        @foreach (var project in Model.Projects.Where(p => p.Status == SalesTracker.Core.Models.ProjectStatus.Lost))
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-body">
                                    <h6 class="card-title fw-bold">@project.Customer</h6>
                                    <p class="card-text small text-muted mb-2">@project.CategoryName</p>
                                    <p class="card-text fw-black text-danger">€@project.Amount.ToString("N0")</p>
                                    <p class="card-text small text-muted">@project.Date.ToString("dd/MM/yyyy")</p>
                                    @if (!string.IsNullOrEmpty(project.LostReason))
                                    {
                                        <p class="card-text small text-danger">Reason: @project.LostReason</p>
                                    }
                                    <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-primary">Edit</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showView(view) {
            const tableView = document.getElementById('tableView');
            const kanbanView = document.getElementById('kanbanView');
            const btnTable = document.getElementById('btn-table');
            const btnKanban = document.getElementById('btn-kanban');

            if (view === 'table') {
                tableView.classList.remove('d-none');
                kanbanView.classList.add('d-none');
                btnTable.classList.remove('btn-outline-primary');
                btnTable.classList.add('btn-primary');
                btnKanban.classList.remove('btn-primary');
                btnKanban.classList.add('btn-outline-primary');
            } else {
                tableView.classList.add('d-none');
                kanbanView.classList.remove('d-none');
                btnKanban.classList.remove('btn-outline-primary');
                btnKanban.classList.add('btn-primary');
                btnTable.classList.remove('btn-primary');
                btnTable.classList.add('btn-outline-primary');
            }
        }
    </script>
}

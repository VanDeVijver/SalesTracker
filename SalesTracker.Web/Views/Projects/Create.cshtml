@model SalesTracker.Web.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "Create Project";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-8">
        <h1 class="text-4xl font-black text-blue-900 uppercase">Create New Project</h1>
        <p class="text-slate-600 mt-2">Add a new project to the system</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-8">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 p-4 mb-6"></div>

            <!-- Basic Information -->
            <div class="mb-8">
                <h2 class="text-2xl font-black text-blue-900 uppercase mb-4 border-b-2 border-blue-900 pb-2">Basic Information</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Date" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <input asp-for="Date" type="date" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" />
                        <span asp-validation-for="Date" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Customer" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <input asp-for="Customer" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="Customer name" />
                        <span asp-validation-for="Customer" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ClientType" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <select asp-for="ClientType" asp-items="Html.GetEnumSelectList<SalesTracker.Core.Models.ClientType>()" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition">
                        </select>
                        <span asp-validation-for="ClientType" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-bold text-slate-700 mb-2 uppercase">Category</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="LeadChannelId" class="block text-sm font-bold text-slate-700 mb-2 uppercase">Lead Channel</label>
                        <select asp-for="LeadChannelId" asp-items="ViewBag.LeadChannels" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition">
                            <option value="">-- Select Lead Channel --</option>
                        </select>
                        <span asp-validation-for="LeadChannelId" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Status" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<SalesTracker.Core.Models.ProjectStatus>()" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition">
                        </select>
                        <span asp-validation-for="Status" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Financial Information - Quote -->
            <div class="mb-8">
                <h2 class="text-2xl font-black text-blue-900 uppercase mb-4 border-b-2 border-blue-900 pb-2">Financial - Quote (Offerte)</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Amount" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <div class="relative">
                            <span class="absolute left-4 top-3 text-slate-500 font-bold">€</span>
                            <input asp-for="Amount" type="number" step="0.01" class="w-full pl-8 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Purchase" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <div class="relative">
                            <span class="absolute left-4 top-3 text-slate-500 font-bold">€</span>
                            <input asp-for="Purchase" type="number" step="0.01" class="w-full pl-8 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Purchase" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ManualMarginPercentage" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <div class="relative">
                            <input asp-for="ManualMarginPercentage" type="number" step="0.01" min="0" max="100" class="w-full pr-12 pl-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                            <span class="absolute right-4 top-3 text-slate-500 font-bold">%</span>
                        </div>
                        <span asp-validation-for="ManualMarginPercentage" class="text-red-500 text-xs mt-1 block"></span>
                        <div class="text-xs text-slate-500 mt-1">
                            Calculated: €<span id="calculatedManualMargin">0.00</span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Hours" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <input asp-for="Hours" type="number" step="0.01" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                        <span asp-validation-for="Hours" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Financial Information - Actual -->
            <div class="mb-8">
                <h2 class="text-2xl font-black text-blue-900 uppercase mb-4 border-b-2 border-blue-900 pb-2">Financial - Actual (Cafca/Nacalculatie)</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="CafcaMarginPercentage" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                        <div class="relative">
                            <input asp-for="CafcaMarginPercentage" type="number" step="0.01" min="0" max="100" class="w-full pr-12 pl-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                            <span class="absolute right-4 top-3 text-slate-500 font-bold">%</span>
                        </div>
                        <span asp-validation-for="CafcaMarginPercentage" class="text-red-500 text-xs mt-1 block"></span>
                        <div class="text-xs text-slate-500 mt-1">
                            Calculated: €<span id="calculatedCafcaMargin">0.00</span>
                        </div>

                        <div>
                            <label asp-for="CafcaHours" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                            <input asp-for="CafcaHours" type="number" step="0.01" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                            <span asp-validation-for="CafcaHours" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="FinalInvoiceAmount" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                            <div class="relative">
                                <span class="absolute left-4 top-3 text-slate-500 font-bold">€</span>
                                <input asp-for="FinalInvoiceAmount" type="number" step="0.01" class="w-full pl-8 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="FinalInvoiceAmount" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="EndDate" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                            <input asp-for="EndDate" type="date" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" />
                            <span asp-validation-for="EndDate" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="mb-8">
                    <h2 class="text-2xl font-black text-blue-900 uppercase mb-4 border-b-2 border-blue-900 pb-2">Additional Information</h2>

                    <div class="space-y-6">
                        <div>
                            <label asp-for="LostReason" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                            <input asp-for="LostReason" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="Reason for losing the project (if applicable)" />
                            <span asp-validation-for="LostReason" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Notes" class="block text-sm font-bold text-slate-700 mb-2 uppercase"></label>
                            <textarea asp-for="Notes" rows="4" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:outline-none transition" placeholder="Additional notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-4 justify-end">
                    <a asp-action="Index" class="px-6 py-3 border-2 border-slate-300 text-slate-700 rounded-xl font-black uppercase hover:bg-slate-50 transition">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-3 bg-blue-900 text-white rounded-xl font-black uppercase hover:bg-blue-800 transition">
                        Create Project
                    </button>
                </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Calculate manual margin amount
        function calculateManualMargin() {
            const amount = parseFloat(document.getElementById('Amount').value) || 0;
            const percentage = parseFloat(document.getElementById('ManualMarginPercentage').value) || 0;
            const marginAmount = amount * (percentage / 100);
            document.getElementById('calculatedManualMargin').textContent = marginAmount.toFixed(2);
        }

        // Calculate cafca margin amount
        function calculateCafcaMargin() {
            const finalAmount = parseFloat(document.getElementById('FinalInvoiceAmount').value) || 0;
            const percentage = parseFloat(document.getElementById('CafcaMarginPercentage').value) || 0;
            const marginAmount = finalAmount * (percentage / 100);
            document.getElementById('calculatedCafcaMargin').textContent = marginAmount.toFixed(2);
        }

        // Add event listeners
        document.getElementById('Amount').addEventListener('input', calculateManualMargin);
        document.getElementById('ManualMarginPercentage').addEventListener('input', calculateManualMargin);
        document.getElementById('FinalInvoiceAmount').addEventListener('input', calculateCafcaMargin);
        document.getElementById('CafcaMarginPercentage').addEventListener('input', calculateCafcaMargin);

        // Calculate on page load
        calculateManualMargin();
        calculateCafcaMargin();
    </script>
}

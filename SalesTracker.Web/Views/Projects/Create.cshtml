@model SalesTracker.Web.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "Create Project";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="display-5 fw-black text-primary">CREATE NEW PROJECT</h1>
        <p class="text-muted">Add a new project to the system</p>
    </div>

    <div class="card shadow">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Basic Information -->
                <div class="mb-5">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">BASIC INFORMATION</h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Date" class="form-label fw-bold text-uppercase small"></label>
                            <input asp-for="Date" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Customer" class="form-label fw-bold text-uppercase small"></label>
                            <input asp-for="Customer" class="form-control form-control-lg" placeholder="Customer name" />
                            <span asp-validation-for="Customer" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClientType" class="form-label fw-bold text-uppercase small"></label>
                            <select asp-for="ClientType" asp-items="Html.GetEnumSelectList<SalesTracker.Core.Models.ClientType>()" class="form-select form-select-lg">
                            </select>
                            <span asp-validation-for="ClientType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold text-uppercase small">Category</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select form-select-lg">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadChannelId" class="form-label fw-bold text-uppercase small">Lead Channel</label>
                            <select asp-for="LeadChannelId" asp-items="ViewBag.LeadChannels" class="form-select form-select-lg">
                                <option value="">-- Select Lead Channel --</option>
                            </select>
                            <span asp-validation-for="LeadChannelId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold text-uppercase small"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<SalesTracker.Core.Models.ProjectStatus>()" class="form-select form-select-lg">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Financial Information - Quote -->
                <div class="mb-5">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">FINANCIAL - QUOTE (OFFERTE)</h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-bold text-uppercase small"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text fw-bold">€</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Purchase" class="form-label fw-bold text-uppercase small"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text fw-bold">€</span>
                                <input asp-for="Purchase" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Purchase" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ManualMarginPercentage" class="form-label fw-bold text-uppercase small"></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="ManualMarginPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="0.00" id="ManualMarginPercentage" />
                                <span class="input-group-text fw-bold">%</span>
                            </div>
                            <span asp-validation-for="ManualMarginPercentage" class="text-danger small"></span>
                            <div class="form-text">
                                Calculated: €<span id="calculatedManualMargin" class="fw-bold">0.00</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Hours" class="form-label fw-bold text-uppercase small"></label>
                            <input asp-for="Hours" type="number" step="0.01" class="form-control form-control-lg" placeholder="0.00" />
                            <span asp-validation-for="Hours" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Financial Information - Actual -->
                <div class="mb-5">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">FINANCIAL - ACTUAL (CAFCA/NACALCULATIE)</h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CafcaMarginPercentage" class="form-label fw-bold text-uppercase small"></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="CafcaMarginPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="0.00" id="CafcaMarginPercentage" />
                                <span class="input-group-text fw-bold">%</span>
                            </div>
                            <span asp-validation-for="CafcaMarginPercentage" class="text-danger small"></span>
                            <div class="form-text">
                                Calculated: €<span id="calculatedCafcaMargin" class="fw-bold">0.00</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CafcaHours" class="form-label fw-bold text-uppercase small"></label>
                            <input asp-for="CafcaHours" type="number" step="0.01" class="form-control form-control-lg" placeholder="0.00" />
                            <span asp-validation-for="CafcaHours" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FinalInvoiceAmount" class="form-label fw-bold text-uppercase small"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text fw-bold">€</span>
                                <input asp-for="FinalInvoiceAmount" type="number" step="0.01" class="form-control" placeholder="0.00" id="FinalInvoiceAmount" />
                            </div>
                            <span asp-validation-for="FinalInvoiceAmount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-bold text-uppercase small"></label>
                            <input asp-for="EndDate" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="mb-4">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">ADDITIONAL INFORMATION</h3>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="LostReason" class="form-label fw-bold text-uppercase small"></label>
                            <input asp-for="LostReason" class="form-control form-control-lg" placeholder="Reason for losing the project (if applicable)" />
                            <span asp-validation-for="LostReason" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-bold text-uppercase small"></label>
                            <textarea asp-for="Notes" rows="4" class="form-control form-control-lg" placeholder="Additional notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">PROJECT CHECKLIST</h3>

                    <div class="card bg-light border-2">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckCafca" type="checkbox" class="form-check-input" />
                                        <label asp-for="CheckCafca" class="form-check-label fw-bold">In CafCa</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckFolder" type="checkbox" class="form-check-input" />
                                        <label asp-for="CheckFolder" class="form-check-label fw-bold">Mapje (Folder)</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckMaterial" type="checkbox" class="form-check-input" />
                                        <label asp-for="CheckMaterial" class="form-check-label fw-bold">Materiaal (Material)</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckPlanning" type="checkbox" class="form-check-input" />
                                        <label asp-for="CheckPlanning" class="form-check-label fw-bold">Planning</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-black text-uppercase px-5">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg fw-black text-uppercase px-5">
                        Create Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Calculate manual margin amount
        function calculateManualMargin() {
            const amount = parseFloat(document.getElementById('Amount').value) || 0;
            const percentage = parseFloat(document.getElementById('ManualMarginPercentage').value) || 0;
            const marginAmount = amount * (percentage / 100);
            document.getElementById('calculatedManualMargin').textContent = marginAmount.toFixed(2);
        }

        // Calculate cafca margin amount
        function calculateCafcaMargin() {
            const finalAmount = parseFloat(document.getElementById('FinalInvoiceAmount').value) || 0;
            const percentage = parseFloat(document.getElementById('CafcaMarginPercentage').value) || 0;
            const marginAmount = finalAmount * (percentage / 100);
            document.getElementById('calculatedCafcaMargin').textContent = marginAmount.toFixed(2);
        }

        // Add event listeners
        document.getElementById('Amount').addEventListener('input', calculateManualMargin);
        document.getElementById('ManualMarginPercentage').addEventListener('input', calculateManualMargin);
        document.getElementById('FinalInvoiceAmount').addEventListener('input', calculateCafcaMargin);
        document.getElementById('CafcaMarginPercentage').addEventListener('input', calculateCafcaMargin);

        // Calculate on page load
        calculateManualMargin();
        calculateCafcaMargin();
    </script>
}

@model SalesTracker.Web.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "Edit Project";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="display-5 fw-black text-primary">EDIT PROJECT</h1>
        <p class="text-muted">Update project information</p>
    </div>

    <div class="card shadow">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="newLogEntry" id="newLogEntry" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- ... existing Basic Information section ... -->
                <!-- ... existing Financial - Quote section ... -->
                <!-- ... existing Financial - Actual section ... -->
                <!-- ... existing Additional Information section ... -->
                <!-- ===== NEW: Project Checklist ===== -->
                <div class="mb-5">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">PROJECT CHECKLIST</h3>

                    <div class="card bg-light border-2">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckCafca" type="checkbox" class="form-check-input" id="checkCafca" />
                                        <label asp-for="CheckCafca" class="form-check-label fw-bold">In CafCa</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckFolder" type="checkbox" class="form-check-input" id="checkFolder" />
                                        <label asp-for="CheckFolder" class="form-check-label fw-bold">Mapje (Folder)</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckMaterial" type="checkbox" class="form-check-input" id="checkMaterial" />
                                        <label asp-for="CheckMaterial" class="form-check-label fw-bold">Materiaal (Material)</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input asp-for="CheckPlanning" type="checkbox" class="form-check-input" id="checkPlanning" />
                                        <label asp-for="CheckPlanning" class="form-check-label fw-bold">Planning</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== NEW: Project Log ===== -->
                <div class="mb-4">
                    <h3 class="fw-black text-primary mb-3 pb-2 border-bottom border-primary border-3">PROJECT LOG (CHRONOLOGISCH)</h3>

                    <div class="card border-2 border-dashed">
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="input-group">
                                    <input type="text" id="logEntryInput" class="form-control" placeholder="Typ hier een nieuwe update..." />
                                    <button type="button" onclick="addLogEntry()" class="btn btn-primary fw-bold text-uppercase">
                                        Log toevoegen
                                    </button>
                                </div>
                            </div>

                            <div id="logHistory" class="border rounded p-3" style="max-height: 300px; overflow-y: auto; background-color: var(--bg-lighter);">
                                @if (Model.LogEntries != null && Model.LogEntries.Any())
                                {
                                    foreach (var entry in Model.LogEntries.OrderByDescending(e => e.Timestamp))
                                    {
                                        <div class="mb-2 pb-2 border-bottom">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <p class="mb-1 fw-semibold">@entry.Message</p>
                                                    <small class="text-muted">
                                                        <span class="fw-bold">@entry.UserName</span> •
                                                        @entry.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted text-center mb-0">Geen log entries nog</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-black text-uppercase px-5">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg fw-black text-uppercase px-5">
                        Update Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Calculate manual margin amount
        function calculateManualMargin() {
            const amount = parseFloat(document.getElementById('Amount').value) || 0;
            const percentage = parseFloat(document.getElementById('ManualMarginPercentage').value) || 0;
            const marginAmount = amount * (percentage / 100);
            document.getElementById('calculatedManualMargin').textContent = marginAmount.toFixed(2);
        }

        // Calculate cafca margin amount
        function calculateCafcaMargin() {
            const finalAmount = parseFloat(document.getElementById('FinalInvoiceAmount').value) || 0;
            const percentage = parseFloat(document.getElementById('CafcaMarginPercentage').value) || 0;
            const marginAmount = finalAmount * (percentage / 100);
            document.getElementById('calculatedCafcaMargin').textContent = marginAmount.toFixed(2);
        }

        // Add event listeners
        document.getElementById('Amount').addEventListener('input', calculateManualMargin);
        document.getElementById('ManualMarginPercentage').addEventListener('input', calculateManualMargin);
        document.getElementById('FinalInvoiceAmount').addEventListener('input', calculateCafcaMargin);
        document.getElementById('CafcaMarginPercentage').addEventListener('input', calculateCafcaMargin);

        // Calculate on page load
        calculateManualMargin();
        calculateCafcaMargin();

        // ===== NEW: Log Entry Functionality =====
        function addLogEntry() {
            const input = document.getElementById('logEntryInput');
            const message = input.value.trim();

            if (!message) {
                alert('Please enter a log message');
                return;
            }

            // Set the hidden field value
            document.getElementById('newLogEntry').value = message;

            // Submit the form
            document.getElementById('editForm').submit();
        }

        // Allow Enter key to add log entry
        document.getElementById('logEntryInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addLogEntry();
            }
        });
    </script>
}

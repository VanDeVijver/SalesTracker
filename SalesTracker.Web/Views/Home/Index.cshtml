@model SalesTracker.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mx-auto px-4 py-8">
    <!-- Year Selector -->
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-4xl font-black text-blue-900 uppercase">VENERGY CRM Dashboard</h1>
        <div class="flex gap-4 items-center">
            <label class="text-sm font-bold text-slate-700">Year:</label>
            <select id="yearSelector" class="px-4 py-2 border-2 border-slate-200 rounded-xl font-bold" onchange="changeYear(this.value)">
                @foreach (var year in ViewBag.Years)
                {
                    <option value="@year" selected="@(year == Model.CurrentYear)">@year</option>
                }
            </select>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-blue-500">
            <div class="text-sm font-bold text-slate-500 uppercase mb-2">Total Projects</div>
            <div class="text-3xl font-black text-blue-900">@Model.Stats["TotalProjects"]</div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-green-500">
            <div class="text-sm font-bold text-slate-500 uppercase mb-2">Won Projects</div>
            <div class="text-3xl font-black text-green-600">@Model.Stats["WonProjects"]</div>
            <div class="text-sm text-slate-600 mt-2">€@Model.Stats["WonValue"].ToString("N0")</div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-yellow-500">
            <div class="text-sm font-bold text-slate-500 uppercase mb-2">Pending Projects</div>
            <div class="text-3xl font-black text-yellow-600">@Model.Stats["PendingProjects"]</div>
            <div class="text-sm text-slate-600 mt-2">€@Model.Stats["PendingValue"].ToString("N0")</div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-red-500">
            <div class="text-sm font-bold text-slate-500 uppercase mb-2">Lost Projects</div>
            <div class="text-3xl font-black text-red-600">@Model.Stats["LostProjects"]</div>
            <div class="text-sm text-slate-600 mt-2">€@Model.Stats["LostValue"].ToString("N0")</div>
        </div>
    </div>

    <!-- Financial Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-gradient-to-br from-blue-900 to-blue-700 rounded-2xl shadow-xl p-6 text-white">
            <div class="text-sm font-bold uppercase mb-2 opacity-80">Total Revenue</div>
            <div class="text-4xl font-black">€@Model.Stats["TotalRevenue"].ToString("N0")</div>
        </div>

        <div class="bg-gradient-to-br from-green-600 to-green-500 rounded-2xl shadow-xl p-6 text-white">
            <div class="text-sm font-bold uppercase mb-2 opacity-80">Total Margin</div>
            <div class="text-4xl font-black">€@Model.Stats["TotalMargin"].ToString("N0")</div>
        </div>

        <div class="bg-gradient-to-br from-purple-600 to-purple-500 rounded-2xl shadow-xl p-6 text-white">
            <div class="text-sm font-bold uppercase mb-2 opacity-80">Margin %</div>
            <div class="text-4xl font-black">
                @{
                    var marginPercent = Model.Stats["TotalRevenue"] > 0
                        ? (Model.Stats["TotalMargin"] / Model.Stats["TotalRevenue"] * 100)
                        : 0;
                }
                @marginPercent.ToString("F1")%
            </div>
        </div>
    </div>

    <!-- Category Breakdown -->
    <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
        <h2 class="text-2xl font-black text-blue-900 uppercase mb-6">Category Breakdown</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var category in Model.CategoryBreakdown)
            {
                <div class="border-2 border-slate-200 rounded-xl p-4">
                    <div class="text-sm font-bold text-slate-700 uppercase mb-2">@category.Key</div>
                    <div class="text-2xl font-black text-blue-900">€@category.Value.ToString("N0")</div>
                </div>
            }
        </div>
    </div>

    <!-- Status Breakdown Chart -->
    <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
        <h2 class="text-2xl font-black text-blue-900 uppercase mb-6">Status Distribution</h2>
        <div class="flex gap-8 items-center">
            <div class="flex-1">
                <canvas id="statusChart" height="200"></canvas>
            </div>
            <div class="space-y-4">
                @foreach (var status in Model.StatusBreakdown)
                {
                    var color = status.Key switch
                    {
                        "Pending" => "yellow",
                        "Won" => "green",
                        "Lost" => "red",
                        _ => "gray"
                    };
                    <div class="flex items-center gap-3">
                        <div class="w-4 h-4 rounded-full bg-@(color)-500"></div>
                        <span class="font-bold text-slate-700">@status.Key: @status.Value</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Projects -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-black text-blue-900 uppercase">Recent Projects</h2>
            <a asp-controller="Projects" asp-action="Index" class="text-blue-600 font-bold hover:underline">View All →</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b-2 border-slate-200">
                        <th class="text-left py-3 px-4 font-black text-slate-700 uppercase text-xs">Date</th>
                        <th class="text-left py-3 px-4 font-black text-slate-700 uppercase text-xs">Customer</th>
                        <th class="text-left py-3 px-4 font-black text-slate-700 uppercase text-xs">Category</th>
                        <th class="text-left py-3 px-4 font-black text-slate-700 uppercase text-xs">Status</th>
                        <th class="text-right py-3 px-4 font-black text-slate-700 uppercase text-xs">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.RecentProjects)
                    {
                        var statusColor = project.Status switch
                        {
                            SalesTracker.Core.Models.ProjectStatus.Pending => "yellow",
                            SalesTracker.Core.Models.ProjectStatus.Won => "green",
                            SalesTracker.Core.Models.ProjectStatus.Lost => "red",
                            _ => "gray"
                        };
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="py-3 px-4 text-sm">@project.Date.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 px-4 font-bold">@project.Customer</td>
                            <td class="py-3 px-4 text-sm">@project.CategoryName</td>
                            <td class="py-3 px-4">
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-@(statusColor)-100 text-@(statusColor)-700">
                                    @project.Status
                                </span>
                            </td>
                            <td class="py-3 px-4 text-right font-bold">€@((project.FinalInvoiceAmount ?? project.Amount).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function changeYear(year) {
            window.location.href = `/?year=${year}`;
        }

        // Status Chart
        const ctx = document.getElementById('statusChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'Won', 'Lost'],
                datasets: [{
                    data: [@Model.StatusBreakdown["Pending"], @Model.StatusBreakdown["Won"], @Model.StatusBreakdown["Lost"]],
                    backgroundColor: ['#eab308', '#22c55e', '#ef4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    </script>
}
